# ==========================================
# Aerix Ticket - Environment Configuration
# ==========================================

# Discord Bot Credentials
# Obtain from https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_SECRET=your_discord_client_secret_here

# Database Configuration
# Supported providers: sqlite, mysql, postgresql
DB_PROVIDER=sqlite
DB_CONNECTION_URL="file:./database.db"

# Security & Data Encryption
# Generate a 48-character hex key using: npm run keygen
ENCRYPTION_KEY=your_48_character_hex_encryption_key_here
DISABLE_ENCRYPTION=false
INVALIDATE_TOKENS=2026-01-01T00:00:00.000Z

# Web Dashboard & HTTP Server Configuration
HTTP_HOST=0.0.0.0
HTTP_PORT=8169
HTTP_EXTERNAL=http://localhost:8169
HTTP_INTERNAL=http://127.0.0.1:8169
HTTP_TRUST_PROXY=false
NODE_ENV=production

# Bot Administration
# Discord User ID of the primary administrator / superuser
SUPER=your_discord_user_id_here
PUBLIC_BOT=false
PUBLISH_COMMANDS=true
OVERRIDE_ARCHIVE=false
CPU_LIMIT=0
